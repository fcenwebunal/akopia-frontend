# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files — .env.example es la plantilla sin secretos, sí se versiona
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Logs locales
*.log

# Copiado en postinstall desde node_modules/maplibre-gl — ver
# scripts/copy-maplibre-worker.mjs. Se regenera solo, no se versiona.
/public/maplibre-gl-worker.mjs
