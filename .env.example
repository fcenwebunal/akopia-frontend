# URL del backend PocketBase.
# En local: http://127.0.0.1:8090
# En produccion: https://acopio.manizales.unal.edu.co
NEXT_PUBLIC_PB_URL=http://127.0.0.1:8090

# Configuracion web de Firebase (proyecto "akopia"). No es secreta: viaja
# en el bundle del cliente a proposito, y se restringe por dominio desde
# la consola de Firebase, no ocultandola. Pidele los valores reales a
# quien administra el proyecto de Firebase si no los tienes.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=akopia.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=akopia
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=akopia.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=

# Superusuario de servicio de PocketBase. ESTO SI ES SECRETO: con el, el
# puente /api/auth/firebase puede actuar como cualquier usuario de la
# aplicacion. Creas el tuyo una sola vez por entorno, dentro de
# akopia-backend:
#   ./pocketbase.exe superuser upsert servicio@akopia.internal "una-clave-larga-y-tuya"
# y pones aqui exactamente esas mismas credenciales.
POCKETBASE_SERVICE_EMAIL=servicio@akopia.internal
POCKETBASE_SERVICE_PASSWORD=

# Cloudinary, para las fotos de categorías y productos. El cloud name no
# es secreto. La API key y sobre todo el API secret SÍ lo son: con el
# secret cualquiera podría firmar subidas arbitrarias a la cuenta, así
# que nunca llevan NEXT_PUBLIC_. Pídele las credenciales reales a quien
# administra la cuenta de Cloudinary del proyecto.
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Token público de Mapbox (geocoding y autocompletado de direcciones en
# los formularios de solicitud/despacho). No es secreto: viaja al
# cliente a propósito, como el de Firebase — se restringe por URL desde
# el dashboard de Mapbox (Tokens → URL restrictions), no ocultándolo.
# Sin este valor, AddressMapField (src/components/app/) sigue mostrando
# los cuatro campos de dirección, pero el buscador, el mapa y el
# geocoding automático quedan desactivados con un aviso explícito.
NEXT_PUBLIC_MAPBOX_TOKEN=
